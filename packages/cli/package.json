{
  "name": "@wcai/cli",
  "version": "1.2.1",
  "description": "Standalone CLI for Web Component AI Tools - provides MCP server for AI assistants",
  "author": {
    "name": "Keith Daulton",
    "email": "kdaulton@d13design.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/d13/vscode-web-components-ai",
  "bugs": {
    "url": "https://github.com/d13/vscode-web-components-ai/issues"
  },
  "repository": {
    "url": "https://github.com/d13/vscode-web-components-ai.git",
    "type": "git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai",
    "mcp",
    "model-context-protocol",
    "web-components",
    "custom-elements",
    "lit",
    "stencil",
    "angular",
    "vue",
    "react",
    "cli",
    "assistant",
    "copilot",
    "claude",
    "cursor",
    "windsurf"
  ],
  "engines": {
    "node": "^20.18.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "wcai": "./bin/wcai"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "tsc",
    "clean": "rimraf dist coverage",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@wc-toolkit/cem-utilities": "^1.4.1",
    "commander": "^12.1.0",
    "custom-elements-manifest": "^2.1.0",
    "glob": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.2"
  }
}
